# ==============================================================================
#  CONFIGURACIÓN DE SERVICIO DE CORREO ELECTRÓNICO (SMTP) - ROSARIO COMPRAS
# ==============================================================================
# Copia este archivo como .env para activar el envío real de correos.
# Si estos valores quedan vacíos, el sistema funcionará en MODO SIMULACIÓN (los correos se registrarán en logs/email_simulados.log).

# Servidor SMTP (ej: smtp.gmail.com, smtp.office365.com, smtp.mailgun.org, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Credenciales de Autenticación
# (Para Gmail, recuerda generar una "Contraseña de Aplicación" de 16 caracteres en la seguridad de tu cuenta de Google)
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_aqui

# Datos del Remitente
EMAIL_FROM_NAME="Rosario Compras - Gestión de Abastecimiento"
EMAIL_FROM_ADDRESS=tu_correo@gmail.com
